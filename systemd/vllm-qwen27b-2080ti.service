[Unit]
Description=vLLM Qwen3.8-27B FP8 138K MTP (2x2080Ti) launcher-managed boot start
After=network-online.target docker.service tailscaled.service
Wants=network-online.target

[Service]
Type=forking
User=lingyuzeng
Group=lingyuzeng
WorkingDirectory=/home/lingyuzeng/project/vllm-2080ti
EnvironmentFile=/home/lingyuzeng/project/vllm-2080ti/systemd/vllm-boot.env
ExecStart=/home/lingyuzeng/project/vllm-2080ti/systemd/vllm-boot.sh
PIDFile=/home/lingyuzeng/project/vllm-2080ti/run-logs/vllm-qwen27b-fp8-fp16kv-138K-mtp3-text-only-cu128.pid
RemainAfterExit=no
Restart=on-failure
RestartSec=30
TimeoutStartSec=2700
TimeoutStopSec=240
LimitNOFILE=65536
LimitNPROC=65536
StandardOutput=journal
StandardError=journal
SyslogIdentifier=vllm-qwen27b

[Install]
WantedBy=multi-user.target
