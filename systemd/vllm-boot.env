# Boot-time vLLM configuration.
# Mirrors the live instance (see run-logs/start-manager.state).
MODEL_DIR=/home/lingyuzeng/models/Qwen3.8-27B-Uncensored-FP8
PROFILE=qwen27b/normal/fp8/fp16kv-138K-mtp3-text-only.env
MODE=normal
PORT=8000
SERVICE_SCOPE=lan
GPU_DEVICES=0,1
TP_SIZE=2
START_TIMEOUT=2400
ENABLE_AUTO_TOOL_CHOICE=1
TOOL_CALL_PARSER=qwen3_xml
VLLM_ENFORCE_STRICT_TOOL_CALLING=1
CUDA_VISIBLE_DEVICES=0,1
CUDA_DEVICE_ORDER=PCI_BUS_ID
